rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User private data hierarchy
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /semesters/{semesterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        match /subjects/{subjectId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
        
        match /timetables/{timetableId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
          
          match /entries/{entryId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
          }
        }
        
        match /classOccurrences/{occurrenceId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
        
        match /attendance/{attendanceId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /reminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Published official college timetables (read-only for students)
    match /colleges/{collegeId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin workflows only

      match /publishedTimetables/{timetableId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /publishedTimetables/{timetableId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
